# Copie este arquivo para ".env" (o "npm run setup" faz isso sozinho) e ajuste a senha.

# Porta do servidor web. Se aparecer "porta já está em uso", troque (ex.: 3001).
PORT=3000
# Endereço do servidor web. 127.0.0.1 = só este computador; 0.0.0.0 = acessível na rede.
HOST=127.0.0.1

# Endereço do PostgreSQL (use 127.0.0.1, não "localhost").
DB_HOST=127.0.0.1
# Porta do PostgreSQL (padrão da instalação: 5432).
DB_PORT=5432
# Usuário do PostgreSQL (padrão da instalação: postgres).
DB_USER=postgres
# Senha definida na instalação do PostgreSQL.
DB_PASSWORD=defina_sua_senha_local
# Nome do banco do sistema (criado pelo "npm run setup").
DB_NAME=pronto_socorro
